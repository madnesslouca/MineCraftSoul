# =====================================================
# SISTEMA DE ARCHETYPES - MineCraftSoul
# =====================================================
# Versão: 3.0 (sintaxe verificada contra a documentação oficial do Skript)
#
# ---------------------------------------------------------------------
# DEPENDÊNCIAS
# ---------------------------------------------------------------------
#   OBRIGATÓRIO : Skript 2.6+
#   OPCIONAL    : addon AuthMe-Skript (APENAS para o menu automático —
#                 ver seção "PRIMEIRO LOGIN" abaixo)
#   OPCIONAL    : SkQuery / TuSKe (para o GUI "open ... to player")
#
#   O menu {@menu} precisa ser definido em arquivo separado:
#     configs/skript/scripts/archetypes-menu.sk
#   Enquanto ele não existir, /archetypes não renderiza nada.
#
#   A variável {almas::UUID} deve bater com soul-economy.sk / forja-almas.sk
#
# ---------------------------------------------------------------------
# NOTAS DE SINTAXE (verificadas na doc oficial)
# ---------------------------------------------------------------------
#   - Em eventos de dano/morte as expressões corretas são "victim" e
#     "attacker". NÃO usar "entity" (retorna o tipo, não o alvo do evento).
#   - "damage" é a expressão documentada para modificar o dano.
#     Em Skript, damage 1 = UM CORAÇÃO CHEIO (não meio coração).
#     Usamos multiplicação (damage * 1.12), que é imune a essa unidade.
#   - "chance of X%:" é usado como linha de condição própria, sem "if".
#   - Cooldown por data: "set {cd} to X seconds from now" e testar
#     "if {cd} is greater than now" (= ainda em cooldown).
#   - "apply <efeito> to <alvo> for <tempo>" é a forma correta
#     (NÃO "apply potion of <efeito>").
#
# ---------------------------------------------------------------------
# AVISO CONHECIDO DO SKRIPT (issue SkriptLang #7728)
# ---------------------------------------------------------------------
#   Modificar "damage" dentro de "on damage" pode reentrar no evento
#   quando o valor final fica abaixo de 2. Testar em servidor: se um
#   bônus aplicar duas vezes, adicionar um guard de flag por tick.
# =====================================================

options:
    prefix: &8[&5Soul&8] &r
    menu: archetype-selection

# =====================================================
# COMANDOS
# =====================================================
# NOTA: não há checagem manual de login aqui de propósito.
# O próprio AuthMe já bloqueia comandos antes da autenticação
# (config "allowCommands"). Duplicar isso no Skript exigiria um addon
# cuja sintaxe varia entre versões — dependência frágil e desnecessária.

command /archetypes:
    description: Abre o menu de escolha de Archetype
    trigger:
        open {@menu} to player

command /archetype:
    description: Mostra seu Archetype atual
    trigger:
        set {_arch} to {archetype::%player's uuid%}
        if {_arch} is set:
            send "{@prefix}Seu Archetype atual é: &d%{_arch}%"
        else:
            send "{@prefix}Você ainda não escolheu um Archetype. Use &f/archetypes&8."

# Fallback administrativo — o fluxo normal do jogador é pelo menu.
command /archetype choose <text>:
    permission: archetypes.choose
    trigger:
        set {archetype::%player's uuid%} to arg-1
        send "{@prefix}Archetype definido para &d%arg-1%&8."
        send "{@prefix}Seus bônus passivos já estão ativos."
        play sound "entity.player.levelup" with volume 0.8 and pitch 1.2 to player

# =====================================================
# PRIMEIRO LOGIN: abre o menu automaticamente
# =====================================================
# ATENÇÃO: "on authme player login" depende do addon AuthMe-Skript e a
# sintaxe varia conforme o addon instalado. Se o console acusar erro de
# parse nesta linha, comente este bloco inteiro e use a alternativa
# "on join" logo abaixo (menos precisa: dispara antes do /login, por isso
# o delay maior).

on authme player login:
    wait 3 seconds
    if player is online:
        if {archetype::%player's uuid%} is not set:
            makeArchetypeWelcome(player)

# ---- ALTERNATIVA SEM ADDON (descomente se o bloco acima falhar) ------
# on join:
#     wait 15 seconds
#     if player is online:
#         if {archetype::%player's uuid%} is not set:
#             makeArchetypeWelcome(player)

# =====================================================
# EFEITOS DOS ARCHETYPES — DANO CAUSADO
# =====================================================
# Handler único: evita que múltiplos "on damage" separados briguem entre si.

on damage:
    # attacker pode ser bloco, fogo, queda ou nada — filtrar antes de tudo
    attacker is a player
    set {_arch} to {archetype::%attacker's uuid%}
    {_arch} is set

    # ── Nascido do Véu: +12% de dano contra Corrompidos ────────────────
    if {_arch} is "Nascido do Véu" or {_arch} is "Veilborn":
        # MythicMobs define o nome exibido como CUSTOM NAME do victim
        if victim's custom name contains "Corrompido" or victim's custom name contains "Corrupted":
            set damage to damage * 1.12

    # ── Alma Cicatrizada: +18% de dano abaixo de 40% de vida ───────────
    if {_arch} is "Alma Cicatrizada" or {_arch} is "Soulscarred":
        # Aritmética precisa sair da condição para uma variável local
        set {_ratio} to attacker's health / attacker's max health
        if {_ratio} <= 0.40:
            set damage to damage * 1.18

    # ── Nascido do Eclipse: 10% de crítico mágico (+50%) ───────────────
    if {_arch} is "Nascido do Eclipse" or {_arch} is "Eclipseborn":
        if damage cause is magic or damage cause is projectile:
            chance of 10%:
                set damage to damage * 1.5
                send action bar "&d&lCRÍTICO MÁGICO!" to attacker

# =====================================================
# EFEITOS DOS ARCHETYPES — DANO RECEBIDO
# =====================================================

on damage of player:
    set {_arch} to {archetype::%victim's uuid%}
    {_arch} is set

    # ── Guardião Oco: cura de emergência abaixo de 30% de vida ─────────
    if {_arch} is "Guardião Oco" or {_arch} is "Hollow Warden":
        set {_ratio} to victim's health / victim's max health
        if {_ratio} <= 0.30:
            set {_cd} to {cooldown::shield::%victim's uuid%}
            # "{_cd} is greater than now" = AINDA em cooldown -> não ativa
            if {_cd} is not set or {_cd} is not greater than now:
                set {cooldown::shield::%victim's uuid%} to 90 seconds from now
                # NOTA DE DESIGN: isto é cura, não escudo de absorção.
                # Se o seu Skript expõe a expressão "absorption", trocar por
                # absorção deixa mais fiel ao doc ("escudo").
                heal victim by (25% of victim's max health)
                send action bar "&a&lEscudo do Guardião ativado! &7(CD 90s)" to victim
                play sound "entity.illusioner.mirror_move" with volume 1 and pitch 0.8 to victim

# =====================================================
# EFEITOS DOS ARCHETYPES — AO MATAR
# =====================================================

on death:
    attacker is a player
    set {_arch} to {archetype::%attacker's uuid%}
    {_arch} is set

    # ── Nascido do Véu: 25% de chance de +1 Alma em Corrompidos ────────
    if {_arch} is "Nascido do Véu" or {_arch} is "Veilborn":
        if victim's custom name contains "Corrompido" or victim's custom name contains "Corrupted":
            chance of 25%:
                add 1 to {almas::%attacker's uuid%}
                send action bar "&b+1 Alma extra &8(Nascido do Véu)" to attacker

    # ── Andarilho da Fenda: invisibilidade 4s ao matar (CD 50s) ────────
    if {_arch} is "Andarilho da Fenda" or {_arch} is "Riftwalker":
        set {_cd} to {cooldown::invis::%attacker's uuid%}
        if {_cd} is not set or {_cd} is not greater than now:
            set {cooldown::invis::%attacker's uuid%} to 50 seconds from now
            apply invisibility to attacker for 4 seconds
            send action bar "&d&lInvisível! &8(CD 50s)" to attacker

# =====================================================
# FUNÇÕES
# =====================================================

# Mensagem de boas-vindas + abertura do menu (usada pelos dois caminhos
# de primeiro login, para não duplicar o texto).
function makeArchetypeWelcome(p: player):
    send "&5&l━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" to {_p}
    send "&d&lBem-vindo ao MineCraftSoul!" to {_p}
    send "&7Como é sua primeira vez aqui, você precisa" to {_p}
    send "&7escolher seu &5Archetype&7 (origem da sua alma)." to {_p}
    send "&5&l━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" to {_p}
    wait 1 second
    if {_p} is online:
        open {@menu} to {_p}
        send action bar "&7Use &f/archetypes &7a qualquer momento." to {_p}

# Retorna o Archetype do jogador ou "Nenhum".
# Uso: set {_arch} to archetypeOf(player)
function archetypeOf(p: player) :: text:
    # Skript não tem ternário inline — precisa de if/return separados
    if {archetype::%{_p}'s uuid%} is set:
        return {archetype::%{_p}'s uuid%}
    return "Nenhum"
