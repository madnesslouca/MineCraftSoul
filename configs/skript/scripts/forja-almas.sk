# ============================================
# FORJA DAS ALMAS - Custo de Almas em Crafting
# ============================================
#
# Intercepta o craft dos itens de alto tier e cobra Almas do jogador
# além dos Fragmentos exigidos pela receita do ItemsAdder.
#
# --------------------------------------------------------------
# DEPENDÊNCIAS
# --------------------------------------------------------------
#   OBRIGATÓRIO : Skript 2.6+
#   OBRIGATÓRIO : addon skript-itemsadder
#                 O Skript puro NÃO reconhece itens do ItemsAdder.
#                 Sintaxe correta: itemsadder item "namespace:id"
#                 (a forma antiga 'custom item "..."' foi removida na 1.6)
#   OBRIGATÓRIO : ItemsAdder com o namespace "minecraftsoul" carregado
#                 -> configs/itemsadder/items/high-tier-items.yml
#
#   A variável {almas::UUID} deve bater com soul-economy.sk e archetypes.sk
#
# --------------------------------------------------------------
# AVISO: EXPLOIT DE SHIFT-CLICK (pendente de decisão)
# --------------------------------------------------------------
#   O evento de craft do Bukkit dispara UMA vez mesmo quando o jogador
#   usa shift-click, que produz o máximo de itens possível de uma vez.
#   Como está, o jogador pagaria 450 Almas e poderia sair com vários
#   itens se tiver Fragmentos suficientes.
#
#   Mitigações possíveis (escolher uma e testar em servidor):
#     a) Remover a receita vanilla e forjar só por GUI/comando dedicado
#        (mais seguro e mais alinhado com a fantasia da "Forja do Véu");
#     b) Cobrar proporcional à quantidade realmente produzida;
#     c) Cancelar o craft quando for shift-click.
#   Não implementei nenhuma ainda para não chutar sintaxe não verificada.
# ============================================

options:
    prefix: &5[Forja das Almas] &r

# ============================================
# LISTENER DE CRAFTING
# ============================================

on craft:
    # Identifica o item forjado e define custo + nome de exibição.
    if event-item is itemsadder item "minecraftsoul:espada_veu_rasgado":
        set {_custo} to 450
        set {_nome} to "Espada do Véu Rasgado"
    else if event-item is itemsadder item "minecraftsoul:peitoral_eco_eterno":
        set {_custo} to 600
        set {_nome} to "Peitoral do Eco Eterno"
    else if event-item is itemsadder item "minecraftsoul:talisma_alma_livre":
        set {_custo} to 350
        set {_nome} to "Talismã da Alma Livre"
    else:
        # Craft comum: não é assunto da Forja
        stop

    # Fallback explícito: variável não-setada não compara de forma confiável
    # com número em Skript (o antigo 'variable {x} = 0' não existe na linguagem)
    set {_almas} to {almas::%player's uuid%}
    if {_almas} is not set:
        set {_almas} to 0

    # Almas insuficientes -> bloqueia a forja
    if {_almas} < {_custo}:
        cancel event
        send "{@prefix}&cVocê precisa de &e%{_custo}% Almas &cpara forjar este item!"
        send "{@prefix}&7Você tem apenas &e%{_almas}% Almas&7."
        stop

    # Cobra o custo
    subtract {_custo} from {almas::%player's uuid%}

    # Aritmética precisa sair da interpolação de texto
    set {_restante} to {_almas} - {_custo}

    send "{@prefix}&aVocê forjou &e%{_nome}%&a!"
    send "{@prefix}&7Gastas &c%{_custo}% Almas&7. Restam &e%{_restante}%&7."
    play sound "entity.player.levelup" with volume 0.8 and pitch 1.2 to player
